# 1. Open Telegram, search @BotFather, create a bot with /newbot -> Paste token below
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Open Telegram, search @userinfobot -> Start -> Paste your ID number below
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Frequency in minutes (defaults to 15)
INTERVAL_MINUTES=15
